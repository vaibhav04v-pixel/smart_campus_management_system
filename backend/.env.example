# ==============================================================================
# Smart Campus Management System — Backend Environment Variables Template
# ==============================================================================
# HOW TO USE:
#   1. Copy this file:  copy .env.example .env   (Windows)
#   2. Fill in your real values in the .env file
#   3. NEVER commit .env to Git — it is blocked by .gitignore
# ==============================================================================

# ── Node Environment ───────────────────────────────────────────────────────────
# Use "development" locally, "production" on a deployed server
NODE_ENV=development

# ── Server Port ───────────────────────────────────────────────────────────────
# The port Express will listen on. Default: 5000
PORT=5000

# ── MongoDB Atlas Connection String ───────────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Replace <username>, <password>, <cluster>, and <dbname> with your Atlas values.
# Find this in Atlas → Your Cluster → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart_campus?retryWrites=true&w=majority

# ── JWT Secret ────────────────────────────────────────────────────────────────
# Any long random string. Used to sign and verify JSON Web Tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_replace_this

# ── JWT Expiry ─────────────────────────────────────────────────────────────────
# How long tokens remain valid. Examples: 1d, 7d, 30d
JWT_EXPIRES_IN=7d

# ── Frontend URL (for CORS) ────────────────────────────────────────────────────
# URL of the React frontend. Vite dev server runs on port 5173 by default.
FRONTEND_URL=http://localhost:5173

# ── Admin Account Setup ────────────────────────────────────────────────────────
# Used only by the explicit `npm run admin:create` command or optional demo seed.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# ── Optional Demo Data ────────────────────────────────────────────────────────
# Used only by `npm run seed:demo`; choose a unique demo-only address and password.
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=
